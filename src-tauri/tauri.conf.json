{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "IFC Sprinkler Viewer",
  "version": "0.1.0",
  "identifier": "de.spk.ifcsprinklerviewer",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "IFC Sprinkler Viewer – Alpha 0.1 · Created by Josef Wagner",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis", "deb", "appimage", "dmg", "app"],
    "publisher": "Josef Wagner",
    "copyright": "© 2026 Josef Wagner",
    "category": "Productivity",
    "shortDescription": "IFC-Viewer und Mengenauszug für Sprinkleranlagen",
    "longDescription": "Öffnet IFC-Modelle (auch sehr große), filtert Sprinkleranlagen nach System, Workset, Geschoss und Bauteilart, zeigt sie vereinfacht in 3D und erstellt einen Mengenauszug mit Excel-Export. Alle Daten bleiben lokal.",
    "fileAssociations": [
      { "ext": ["ifc", "ifczip"], "name": "IFC-Modell", "description": "IFC-Modell", "role": "Viewer" }
    ],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "wix": { "language": "de-DE" },
      "nsis": { "languages": ["German"], "installMode": "currentUser" }
    },
    "linux": {
      "deb": { "depends": [] }
    }
  }
}
